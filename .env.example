# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...): vai para o browser; o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (sb_secret_...): SÓ servidor. Ignora o RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Claude API (https://console.anthropic.com) --- SÓ servidor
ANTHROPIC_API_KEY=sk-ant-xxx
# Modelo usado na análise. Confira os modelos disponíveis na documentação da Anthropic.
ANTHROPIC_MODEL=claude-sonnet-5
# Opcional: modelo mais barato para o de-para de contas (padrão = ANTHROPIC_MODEL).
ANTHROPIC_MODEL_MAPEAMENTO=

# --- Diagnóstico ---
# Token (16+ caracteres) exigido no header x-health-token de /api/health/duckdb.
# Sem ele, a rota responde 404.
HEALTH_CHECK_TOKEN=
# Limites do DuckDB por execução (opcionais).
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2

# --- Retenção de dados ---
# true = apaga arquivos brutos e Parquets do Storage após a análise concluída.
APAGAR_DADOS_BRUTOS_APOS_ANALISE=true
